### Get all exams
### should return 200 - list of exams
GET {{baseUrl}}/exams
Accept: application/json

### Get a single exam by ID
### should return 200 - exam found
GET {{baseUrl}}/exams/1
Accept: application/json

### Get a non-existent exam
### should return 404 - exam not found
GET {{baseUrl}}/exams/9999
Accept: application/json

### Create a new exam session - valid request
### should return 201 - exam created successfully
POST {{baseUrl}}/exams/create
Content-Type: application/json

{
  "userId": 1,
  "topicPoolIds": [1, 2, 3],
  "numberOfQuestions": 6,
  "timeLimitMinutes": 60
}

### Create a new exam session - missing userId
### should return 400 - invalid request
POST {{baseUrl}}/exams/create
Content-Type: application/json

{
  "topicPoolIds": [1, 2, 3],
  "numberOfQuestions": 6,
  "timeLimitMinutes": 60
}

### Create a new exam session - invalid numberOfQuestions
### should return 400 - invalid request (less than minimum)
POST {{baseUrl}}/exams/create
Content-Type: application/json

{
  "userId": 1,
  "topicPoolIds": [1, 2, 3],
  "numberOfQuestions": 0,
  "timeLimitMinutes": 60
}

### Create a new exam session - invalid timeLimitMinutes
### should return 400 - invalid request (less than minimum)
POST {{baseUrl}}/exams/create
Content-Type: application/json

{
  "userId": 1,
  "topicPoolIds": [1, 2, 3],
  "numberOfQuestions": 6,
  "timeLimitMinutes": 0
}

### Create a new exam session - empty topic pools
### should return 400 - invalid request
POST {{baseUrl}}/exams/create
Content-Type: application/json

{
  "userId": 1,
  "topicPoolIds": [],
  "numberOfQuestions": 6,
  "timeLimitMinutes": 60
}


### Submit an exam - valid submission
### should return 200 - graded successfully
POST {{baseUrl}}/exams/submit
Content-Type: application/json

{
  "examId": 1,
  "answers": [
    { "questionId": 1, "selectedAnswerIds": [3] },
    { "questionId": 2, "freeTextAnswer": "42" }
  ]
}

### Submit an exam - non-existent exam
### should return 404 - exam not found
POST {{baseUrl}}/exams/submit
Content-Type: application/json

{
  "examId": 9999,
  "answers": [
    { "questionId": 1, "selectedAnswerIds": [3] }
  ]
}

### Submit an exam - invalid submission
### should return 400 - missing answers
POST {{baseUrl}}/exams/submit
Content-Type: application/json

{
  "examId": 1
}

### Submit an exam - non-existent question in answers
### should return 404 - question not found
POST {{baseUrl}}/exams/submit
Content-Type: application/json

{
  "examId": 1,
  "answers": [
    { "questionId": 9999, "selectedAnswerIds": [1] }
  ]
}
